# Copy this file to .env.local and fill in what you need. Every var below is
# OPTIONAL — the app degrades gracefully without any of them (see CLAUDE.md's
# "Env vars" section for exactly what each stage falls back to when unset).

# --- Gemini (OCR, semantic reasoning, image edits, video, AI prompting) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=

# --- Runware.ai (FLUX.2 image gen, FLUX Fill masked edit, Wan 2.7 video) ---
# Temporary testing setup (2026-07-27) — see context.md workstream 7 for why.
# IMAGE_PROVIDER/VIDEO_PROVIDER default to "runware" when RUNWARE_API_KEY is
# set; set either to "gemini" (or just leave RUNWARE_API_KEY blank) to go
# straight back to the Gemini code paths above, which are untouched.
RUNWARE_API_KEY=
IMAGE_PROVIDER=
VIDEO_PROVIDER=
RUNWARE_IMAGE_MODEL=
RUNWARE_EDIT_MODEL=
RUNWARE_VIDEO_MODEL=
# Second-tier fallback model for both image generation and editing, used when
# the primary Runware model fails — default (unset) is "google:4@3" (Nano
# Banana 2). See src/lib/render/runware-client.ts's header comment for the
# full 3-tier fallback chain (Runware primary -> Runware Nano Banana 2 ->
# direct Google Gemini API).
RUNWARE_FALLBACK_IMAGE_MODEL=
# "sd" (default, unset) = ~720p 16:9, cheapest verified tier. "hd" = ~1080p,
# roughly 2x the cost — opt in only once that tradeoff is accepted. See
# src/lib/render/runware-client.ts's header comment for verified live pricing.
RUNWARE_IMAGE_RESOLUTION=

# Set to "1" to print every prompt this app sends to an AI provider to the
# server console, along with which reference image(s) went with it and which
# model/fallback-chain it's headed to (src/lib/ai/debug-log.ts). Off by
# default — this is a testing aid, not something to leave on in production.
DEBUG_PROMPTS=

# --- Floor-plan geometry detection (Python/OpenCV) ---
# Currently unused by the live app: floor-plan extraction now goes through a
# single Gemini vision call (src/lib/pipeline/extract-plan.ts). This
# Python/OpenCV path (scripts/parse_plan.py, scripts/detect_rooms_labeled.py,
# src/lib/pipeline/opencv.ts) still exists in the codebase but has no caller.
# PYTHON_BIN: override if `python` on PATH isn't a real interpreter (e.g. the
# Windows Store alias stub) — point this at a real python.exe instead.
PYTHON_BIN=
# DETECTOR=labeled swaps in the EasyOCR-assisted room detector.
DETECTOR=
# DETECTION_MODE=gemini skips the Python subprocess entirely, relying on
# Gemini vision alone (see CLAUDE.md). Default (unset) runs both.
DETECTION_MODE=
DETECT_FURNITURE=

# --- Cloudflare R2 (uploaded floor plans + generated renders) ---
# Preferred over plain S3 below: zero egress/bandwidth fees (matters for this
# app's video walkthrough downloads/playback) and no per-image/per-minute fee
# tiers like Cloudinary or Cloudflare Images+Stream. S3-API-compatible, so it
# reuses the same @aws-sdk/client-s3 code path as S3, just pointed at a
# different endpoint/credentials. Used automatically when all four of these
# are set, taking priority over plain S3 below if both happen to be set.
# R2_ACCOUNT_ID: your Cloudflare account ID (R2 dashboard, right sidebar).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from an R2 API token
# ("Manage R2 API Tokens" in the dashboard), not your regular Cloudflare
# account credentials.
# R2_BUCKET: the bucket name you created in R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- AWS S3 (uploaded floor plans + generated renders); local disk storage
#     is used automatically when these AND the R2 vars above are unset ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Supabase (persistence: auth, projects, prompt templates, usage logs) ---
# Run supabase/schema.sql in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Misc ---
RENDER_VERIFY=
